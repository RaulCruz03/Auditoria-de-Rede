# Modelo de configuração do snmpd para o agente da AUTODESCOBERTA-MIB.
# Os marcadores @...@ são preenchidos por scripts/iniciar_snmpd.sh.

# Onde o snmpd escuta (porta 1161: não exige root e não conflita com um snmpd na 161)
agentAddress udp:@ESCUTA@:@PORTA@

# Comunidades SNMPv1/v2c (apenas para ambiente de teste)
rocommunity teste     @FONTE@
rwcommunity teste-rw  @FONTE@

# Delega todo o ramo da MIB do Trabalho 2 ao nosso script, que fala com o snmpd por stdin/stdout.
# (O snmpd divide a linha em espaços simples: sem espaços duplos e sem espaços em caminhos.)
# pass_persist mantém o script vivo entre as consultas (pass, sem persist, o reiniciaria a cada uma).
pass_persist .1.3.6.1.3.99 @COMANDO_AGENTE@
