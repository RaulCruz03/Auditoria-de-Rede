# Configuração do snmpd para o agente da AUTODESCOBERTA-MIB.
# Os marcadores @...@ são preenchidos por scripts/iniciar_snmpd.sh.

# Onde o snmpd escuta (porta 1161: não exige root e não conflita com um snmpd na 161)
agentAddress udp:@ESCUTA@:@PORTA@

# Comunidades SNMPv1/v2c (apenas para ambiente de teste)
rocommunity teste     @FONTE@
rwcommunity teste-rw  @FONTE@

# ETAPA 7 - TODO: escreva aqui a linha que delega o ramo da sua MIB ao agente.
# Formato:  pass_persist <OID da raiz da MIB> <comando que inicia o agente>
# Use @COMANDO_AGENTE@ no lugar do comando: o script troca pelo caminho completo do
# python3 + agente_snmp.py + argumentos. (O snmpd separa a linha por espaços simples.)
